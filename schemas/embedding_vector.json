{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/embedding_vector.json",
  "title": "EmbeddingVector",
  "type": "object",
  "additionalProperties": false,
  "required": ["space", "values", "generated_at"],
  "properties": {
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "model", "model_version", "dimensions", "normalization"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "normalization": { "type": "string", "enum": ["none", "l2"] }
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32768,
      "items": { "type": "number" }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}

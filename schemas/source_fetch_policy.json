{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/source_fetch_policy.json",
  "title": "PublicPageFetchPolicy",
  "description": "Exact domain/path scope and bounded crawl policy for public-page-producing sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed_hosts",
    "allowed_path_prefixes",
    "discovery_modes",
    "max_depth",
    "max_pages_per_run",
    "max_concurrent_requests_per_host",
    "request_timeout_seconds",
    "max_response_bytes",
    "allowed_content_types",
    "obey_robots"
  ],
  "properties": {
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!localhost$)(?!.*[/*@:\\s])[A-Za-z0-9.-]+\\.[A-Za-z]{2,63}$"
      }
    },
    "allowed_path_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^?#]*$"
      },
      "default": [
        "/"
      ]
    },
    "include_subdomains": {
      "type": "boolean",
      "default": false
    },
    "discovery_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "manual",
          "sitemap",
          "rss",
          "atom",
          "json_feed",
          "search_provider_candidates",
          "link"
        ]
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "default": 3
    },
    "max_pages_per_run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 1000
    },
    "max_concurrent_requests_per_host": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 2
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 20
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 20000000,
      "default": 5000000
    },
    "allowed_content_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
      },
      "default": [
        "text/html",
        "application/xhtml+xml",
        "application/rss+xml",
        "application/atom+xml",
        "application/feed+json"
      ]
    },
    "obey_robots": {
      "const": true,
      "default": true
    }
  }
}

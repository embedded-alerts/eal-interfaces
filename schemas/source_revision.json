{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/source_revision.json",
  "title": "SourceRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "tenant_id", "document_id", "content_sha256", "content_text",
    "fetched_at", "metadata"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "previous_revision_id": { "type": ["string", "null"], "format": "uuid" },
    "content_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "content_text": { "type": "string", "minLength": 1, "maxLength": 10000000 },
    "content_type": { "type": ["string", "null"], "maxLength": 256 },
    "language": { "type": ["string", "null"], "maxLength": 64 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}

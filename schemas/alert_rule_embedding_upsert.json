{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/alert_rule_embedding_upsert.json",
  "title": "AlertRuleEmbeddingUpsertRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["alert_rule_revision_id", "embedding"],
  "properties": {
    "alert_rule_revision_id": { "type": "string", "format": "uuid" },
    "embedding": { "$ref": "#/$defs/EmbeddingPayload" }
  },
  "$defs": {
    "EmbeddingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_version", "dimensions", "normalization", "values"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "normalization": { "type": "string", "enum": ["none", "l2", "unit_length"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "items": { "type": "number" }
        }
      }
    }
  }
}

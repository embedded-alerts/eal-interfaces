{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/embedded-alerts/eal-interfaces/schemas/alert_rule.json",
  "title": "AlertRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "status",
    "created_at",
    "updated_at",
    "query",
    "threshold",
    "delivery_channel",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "type": "string"
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "delivery_channel": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    }
  }
}

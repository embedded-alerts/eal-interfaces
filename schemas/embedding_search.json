{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/embedding_search.json",
  "title": "EmbeddingSearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["embedding"],
  "properties": {
    "embedding": { "$ref": "page_ingest.json#/$defs/EmbeddingPayload" },
    "min_similarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.78 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
    "cursor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["distance", "embedding_id"],
      "properties": {
        "distance": { "type": "number" },
        "embedding_id": { "type": "string", "format": "uuid" }
      }
    },
    "source_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    }
  }
}

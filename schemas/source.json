{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.github.io/schemas/source.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "created_by",
    "kind",
    "name",
    "canonical_url",
    "poll_interval_seconds",
    "status",
    "enabled",
    "public_config",
    "fetch_policy",
    "credentials_configured",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "rss",
        "atom",
        "json_feed",
        "search_query",
        "sitemap",
        "web_page",
        "api"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "poll_interval_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 604800
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "error",
        "disabled"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "public_config": {
      "type": "object"
    },
    "fetch_policy": {
      "oneOf": [
        {
          "$ref": "./source_fetch_policy.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "credentials_configured": {
      "type": "boolean"
    },
    "etag": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "last_fetched_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_fetch_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
